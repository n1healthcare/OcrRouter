# OCRRouter Environment Configuration
# Copy this file to .env and configure as needed

# ============ API/Network Settings ============
# VLM server URL (optional)
# Example: http://localhost:8000 or https://api.example.com
OPENAI_BASE_URL=

# API authentication key (optional)
# Required if using a VLM service that requires authentication
OPENAI_API_KEY=

# HTTP request timeout in seconds
# Default: 600
HTTP_TIMEOUT=120

# Maximum concurrent requests
# Default: 100
MAX_CONCURRENCY=20

# Maximum retry attempts for failed requests
# Default: 3
MAX_RETRIES=3

# ============ Backend Settings ============
# Document processing backend to use
# Options: mineru, deepseek, dotsocr, composite
# Default: mineru
BACKEND=mineru

# ============ Composite Backend Settings ============
# These settings are only used when BACKEND=composite
# Allows mix-and-match of layout detection and OCR from different models

# Model to use for layout detection in composite mode
# Options: mineru, deepseek, dotsocr
# Default: mineru
LAYOUT_MODEL=mineru

# Model to use for OCR extraction in composite mode
# Options: mineru, deepseek, dotsocr
# Default: mineru
OCR_MODEL=mineru

# ============ VLM Model Settings ============
# Model name for mineru backend (uses MinerU model)
# Default: mineru-2.5
MINERU_MODEL_NAME=mineru-2.5

# Model name for DeepSeek-OCR backend
# Default: deepseek-ocr
DEEPSEEK_MODEL_NAME=deepseek-ocr

# Model name for DotsOCR backend
# Default: dots-ocr
DOTSOCR_MODEL_NAME=dots-ocr

# DotsOCR extraction mode
# Options: one_step, two_step
# Default: one_step
DOTSOCR_EXTRACTION_MODE=one_step

# ============ Processing Options ============
# Enable mathematical formula extraction
# Options: true, false
# Default: true
FORMULA_ENABLE=true

# Enable table extraction and recognition
# Options: true, false
# Default: true
TABLE_ENABLE=true

# Enable cross-page table merging
# Options: true, false
# Default: true
TABLE_MERGE_ENABLE=true

# ============ Page Range ============
# Starting page index (0-based)
# Default: 0
START_PAGE=0

# Ending page index (leave empty for all pages)
# Example: 10 (process pages 0-10)
# Default: None (process all pages)
END_PAGE=

# ============ Output Options ============
# Draw layout bounding boxes
# Options: true, false
# Default: true
DRAW_LAYOUT_BBOX=true

# Output markdown file
# Options: true, false
# Default: true
DUMP_MD=true

# Output middle JSON file
# Options: true, false
# Default: true
DUMP_MIDDLE_JSON=true

# Output model JSON file
# Options: true, false
# Default: true
DUMP_MODEL_OUTPUT=true

# Save original PDF
# Options: true, false
# Default: true
DUMP_ORIG_PDF=false

# Output content list JSON
# Options: true, false
# Default: true
DUMP_CONTENT_LIST=true

# Markdown generation mode
# Options: mm_markdown, nlp_markdown, content_list, content_list_v2
# Default: mm_markdown
MAKE_MD_MODE=mm_markdown

# ============ Logging ============
# Logging level
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# ============ Debug Settings ============
# Enable debug mode
# Options: true, false
# Default: false
DEBUG=false

# Debug output directory for saving failed requests (optional)
# When DEBUG=true or critical errors occur (timeout/connection), failed VLM requests
# will be saved here with the problematic image, prompt, and error details for analysis
# Example: ./debug or /path/to/debug/output
# Default: ./debug
DEBUG_DIR=
